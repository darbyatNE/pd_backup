# Copy this to .env and fill in values from your Supabase project and AWS account.
# Both frontend (Vite) and backend (Node) read from this file at the repo root.

# ---------- Supabase ----------
# Settings → API in your Supabase dashboard
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: only needed for scripts/create-users.js and other admin tooling.
# The running app uses the anon key + user JWT tokens (RLS), not the service key.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ---------- Backend runtime ----------
PORT=3000
NODE_ENV=development

# Comma-separated list of browser origins allowed to call the API via CORS.
# Set this to your deployed frontend origin(s) in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- AWS S3 (uploads) ----------
# In production, the backend task runs with an IAM role — leave the key vars blank.
# For local development, paste a dev-only IAM user's access key here.
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PRESIGNED_URL_EXPIRY=3600

# ---------- Optional: CloudWatch error logging ----------
# When unset, the backend still accepts /api/client-errors but won't ship to CloudWatch.
FRONTEND_ERROR_LOG_GROUP=/client/powerdime-frontend-errors
