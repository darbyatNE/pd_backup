{
  "name": "powerdime-portal",
  "version": "0.1.0",
  "description": "Power Dime — renewable energy marketplace portal",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "db:tunnel": "bash infra/db-tunnel.sh",
    "predev": "bash infra/db-tunnel.sh up",
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm:backend\" \"npm:frontend\"",
    "build": "npm run build --workspaces --if-present",
    "frontend": "npm run dev --workspace=frontend",
    "backend": "npm run dev --workspace=backend"
  },
  "keywords": [
    "renewable-energy",
    "marketplace",
    "ppa"
  ],
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
